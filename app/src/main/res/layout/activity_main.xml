<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#09090B"
    android:orientation="vertical"
    android:paddingTop="32dp">

    <!-- Top Mill Studio Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#14141C"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="✦ TEXTILE CAD V2"
            android:textColor="#CCFF00"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnApiKey"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="✦ API"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnGeminiPro"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="✦ GEMINI"
            android:textColor="#CCFF00"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnPhotopea"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="PHOTOPEA"
            android:textColor="#38BDF8"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Interactive Workspace (4-Corner Crop + F2/F3 Touch Tracing + CAD Preview) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111116">

        <com.textilecad.pro.PerspectiveCropView
            android:id="@+id/cropView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="1. WhatsApp photo PICK karo\n2. ✦ AI EXTRACT (ya ✦ GEMINI) se flat traced tile nikalo\n3. F2/F3 Trace se touch-up karo\n4. ✦ BUILD PSD + CAD dabao!"
            android:textColor="#A1A1AA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#CC09090B"
            android:gravity="center"
            android:padding="8dp"
            android:text="Step 1: PICK PHOTO dabao"
            android:textColor="#CCFF00"
            android:textSize="11sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Bottom Mill Control Deck -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#14141C"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Row 1: AI Extractor + F2/F3 Touch Tracing Tools -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAiExtract"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="✦ AI EXTRACT"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnTool"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="MODE: 4-PT"
                    android:textSize="10sp" />

                <View
                    android:id="@+id/vColorSwatch"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="6dp"
                    android:background="#000000" />

                <Button
                    android:id="@+id/btnUndo"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="UNDO"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnDotting"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="DOT: OFF"
                    android:textSize="10sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Row 2: Sanganer Mill Standards -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnColors"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="SCREENS: 4"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnChemistry"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="PROCION"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnRotary"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="6.31&quot; (4/cyl)"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnRepeatType"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:text="STRAIGHT"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnResetQuad"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="RESET 4-PT"
                    android:textSize="10sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Row 3: Primary Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPick"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="PICK PHOTO"
                android:textSize="11sp" />

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btnBuildCad"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.5"
                android:text="✦ BUILD PSD + CAD"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
